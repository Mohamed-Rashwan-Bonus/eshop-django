# Copy this file to .env and fill your values
SECRET_KEY=django-insecure-change-me-in-production-123456789
DEBUG=True

# Database: sqlite (default) or postgresql
# To use PostgreSQL, set DB_ENGINE=postgresql and fill the rest,
# then: pip install -r requirements.txt and create the database manually
DB_ENGINE=sqlite
DB_NAME=ecommerce_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
