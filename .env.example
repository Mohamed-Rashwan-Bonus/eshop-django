# Copy this file to .env and fill your values
SECRET_KEY=django-insecure-change-me-in-production-123456789
DEBUG=True

# Database: postgresql (default) or sqlite (automatic fallback)
# setup.bat tries PostgreSQL first and switches to sqlite
# automatically if the server is not reachable.
DB_ENGINE=postgresql
DB_NAME=ecommerce_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
